<table class="border-separate border-spacing-x-1 border border-slate-400">
  <thead>
    <tr>
      <th class="border border-slate-300">品番</th>
      <% koumoku.each do |koumo| %>
        <th class="border border-slate-300">
          <center><font size="3"><%= koumo %></font></center>
        </th>
      <% end %>
    </tr>
  </thead>

  <tbody>
    <% products.group_by(&:partnumber).each do |partnumber, grouped_products| %>
      <tr>
        <td class="border border-slate-300 align-top px-2 py-1">
          <div><%= partnumber %></div>
          <div style="font-size: 11px; color: #4b5563; margin-top: 4px;">
            型No候補:
            <%= product_type_candidates(grouped_products).join(' / ') %>
          </div>
        </td>

        <% koumoku.each do |koumo| %>
          <% stage_status = product_stage_status(grouped_products, koumo, dropdownlist) %>
          <td class="border border-slate-300 text-center">
            <% if stage_status == :complete %>
              <font size="4" color="blue"><%= @mark_complate %></font>
            <% elsif stage_status == :wip %>
              <font size="3" color="magenta"><%= @mark_WIP %></font>
            <% else %>
              <strong><font size="4" color="red">━</font></strong>
            <% end %>
          </td>
        <% end %>
      </tr>
    <% end %>
  </tbody>
</table>

<br>
<%= link_to '戻る', products_path, class: "btn btn-secondary", data: { "turbolinks" => false } %>
