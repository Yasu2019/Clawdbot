<% tabs = supplier_tabs("uploads") %>

<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-600 font-medium rounded-lg inline-block" id="notice"><%= notice %></p>
  <% end %>
  <% if alert.present? %>
    <p class="py-2 px-3 bg-red-50 mb-5 text-red-600 font-medium rounded-lg inline-block"><%= alert %></p>
  <% end %>

  <div class="flex flex-wrap gap-2 mb-4">
    <% tabs.each do |tab| %>
      <% classes = tab[:active] ? "bg-blue-600 text-white" : "bg-gray-100 text-gray-800" %>
      <%= link_to tab[:label], tab[:path], class: "rounded-lg py-2 px-4 font-medium #{classes}" %>
    <% end %>
  </div>

  <div class="flex justify-between items-center mb-4">
    <h1 class="font-bold text-4xl">供給者データ更新</h1>
    <div class="flex gap-2">
      <%= link_to "供給者リスト.xlsx", supplier_excel_download_path, class: "rounded-lg py-2 px-4 font-medium bg-emerald-600 text-white" %>
      <%= link_to "管理計画／実績.xlsx", supplier_excel_download_path("management_plan"), class: "rounded-lg py-2 px-4 font-medium bg-emerald-600 text-white" %>
      <%= link_to "評価表／再評価台帳.xls", supplier_excel_download_path("evaluation"), class: "rounded-lg py-2 px-4 font-medium bg-emerald-600 text-white" %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="border rounded-lg bg-white p-6">
      <h2 class="text-2xl font-bold mb-4">3ファイルをアップロードして自動更新</h2>
      <p class="text-sm text-gray-600 mb-4">
        供給者リストは DB を更新し、管理計画／実績と評価表／再評価台帳は集計ページを再生成します。
        1つだけ差し替えたい場合は、そのファイルだけ選んでも反映できます。
      </p>

      <%= form_with url: upload_sources_suppliers_path, method: :post, multipart: true, local: true, class: "space-y-4" do |form| %>
        <div>
          <label class="block text-sm font-semibold mb-1">供給者リスト.xlsx</label>
          <%= form.file_field :supplier_list_file, accept: ".xlsx", class: "block w-full rounded border px-3 py-2" %>
        </div>
        <div>
          <label class="block text-sm font-semibold mb-1">2025●供給者管理計画／実績表(KGM017).xlsx</label>
          <%= form.file_field :management_plan_file, accept: ".xlsx", class: "block w-full rounded border px-3 py-2" %>
        </div>
        <div>
          <label class="block text-sm font-semibold mb-1">●供給者評価表・供給者再評価記録台帳2025.xls</label>
          <%= form.file_field :evaluation_file, accept: ".xls,.xlsx", class: "block w-full rounded border px-3 py-2" %>
        </div>
        <div class="pt-2">
          <%= form.submit "アップロードして更新", class: "rounded-lg py-3 px-5 bg-blue-600 text-white font-medium" %>
        </div>
      <% end %>
    </div>

    <div class="border rounded-lg bg-white p-6">
      <h2 class="text-2xl font-bold mb-4">最新ステータス</h2>
      <% if @upload_status.present? %>
        <p class="text-sm text-gray-600 mb-4">最終更新: <strong><%= @upload_status["updated_at"] %></strong></p>

        <div class="space-y-3">
          <% (@upload_status["uploaded"] || {}).each do |key, item| %>
            <div class="rounded-lg bg-gray-50 border px-4 py-3">
              <div class="font-semibold"><%= key %></div>
              <div class="text-sm text-gray-700">ファイル: <%= item["filename"] %></div>
              <div class="text-sm text-gray-700">サイズ: <%= number_with_delimiter(item["size"]) %> bytes</div>
            </div>
          <% end %>
        </div>

        <% if @upload_status["results"].present? %>
          <div class="mt-4 rounded-lg bg-slate-50 border px-4 py-3">
            <div class="font-semibold mb-2">更新結果</div>
            <pre class="text-xs whitespace-pre-wrap"><%= JSON.pretty_generate(@upload_status["results"]) %></pre>
          </div>
        <% end %>
      <% else %>
        <p class="text-sm text-gray-600">まだアップロード履歴はありません。</p>
      <% end %>
    </div>
  </div>
</div>
