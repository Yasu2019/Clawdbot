<% if sup.documents.attached? %>
  <div class="flex flex-wrap gap-2 items-start">
    <% sup.documents.each do |image| %>
      <% fullfilename = rails_blob_path(image) %>
      <% ext = File.extname(fullfilename).downcase %>
      <% icon = icon_for_extension(ext) %>
      <% next unless icon.present? %>

      <%= link_to supplier_verify_password_supplier_path(id: image.record.id, blob_id: image.blob.id),
                  class: "inline-flex items-center justify-center rounded border border-slate-200 bg-white p-1 hover:bg-slate-50",
                  data: { toggle: "tooltip" },
                  title: image.blob.filename.to_s do %>
        <%= image_tag(asset_path(icon), class: "h-6 w-6", alt: image.blob.filename.to_s) %>
      <% end %>
    <% end %>
  </div>
<% end %>
