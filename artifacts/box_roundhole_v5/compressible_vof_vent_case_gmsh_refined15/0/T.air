FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0";
    object      T.air;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 508;

boundaryField
{
    gate
    {
        type            fixedValue;
        value           uniform 508;
    }
    vent
    {
        type            inletOutlet;
        inletValue      uniform 298;
        value           uniform 298;
    }
    cavity_wall
    {
        type            fixedValue;
        value           uniform 313;
    }
}


