# ~/.context/.env に配置する例
# 外部APIを使わないローカル優先構成

MILVUS_ADDRESS=http://127.0.0.1:19530
MILVUS_TOKEN=

# Ollama embedding endpoint
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text

# 対象コードベース
OPENCLAW_REPO_ROOT=D:\Clawdbot_Docker_20260125
OPENCLAW_COMPOSE_ROOT=D:\Clawdbot_Docker_20260125\clawstack_v2
