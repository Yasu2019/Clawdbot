  {
    "id": "switch_adc_alarm",
    "type": "switch",
    "z": "tab_wokwi_adc",
    "name": "alarm?",
    "property": "payload.alarm",
    "propertyType": "msg",
    "rules": [
      {
        "t": "true"
      }
    ],
    "checkall": "true",
    "repair": false,
    "outputs": 1,
    "x": 820,
