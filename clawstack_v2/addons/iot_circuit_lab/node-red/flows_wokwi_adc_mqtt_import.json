      ]
    ]
  },
  {
    "id": "fn_adc_alarm_text",
    "type": "function",
    "z": "tab_wokwi_adc",
    "name": "alarm text",
    "func": "msg.topic = 'factory/lab/alarm/text';\\nmsg.payload = `[ADC ALARM] ${msg.payload.device} ${msg.payload.machine} adc=${msg.payload.adc_raw} voltage=${msg.payload.voltage}`;\\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 1000,
    "y": 220,
    "wires": [
