# コピーして .env に変更。秘密情報はここにのみ置く。
APP_ENV=production
READ_ONLY_MODE=true
REQUIRE_HITL=true
ALLOW_EXTERNAL_SEND=false

# OpenClaw / Clawstack
OPENCLAW_GATEWAY_URL=http://host.docker.internal:18789
OPENCLAW_RAG_URL=http://host.docker.internal:18789/rag/search
QDRANT_URL=http://host.docker.internal:6333
RAG_COLLECTION=iatf_knowledge

# n8n
N8N_WEBHOOK_APPROVAL_URL=http://host.docker.internal:5679/webhook/workspace-agent-approval

# SQL Server READ ONLY connection string placeholder
SQLSERVER_DSN=
SQLSERVER_READONLY_USER=
SQLSERVER_READONLY_PASSWORD=

# CSV監視
WATCH_FOLDER=/app/samples
DEFECT_RATE_WARN=0.03
DEFECT_RATE_ALARM=0.05

# 画像生成APIは必要時のみ。キーは直接コミット禁止。
IMAGE_API_PROVIDER=openai
OPENAI_API_KEY=
