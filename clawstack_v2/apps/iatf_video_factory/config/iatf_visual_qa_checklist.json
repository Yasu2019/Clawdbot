{
  "version": "3.0.0",
  "updated": "2026-06-12",
  "purpose": "50-item deterministic + vision checklist per IATF video QA standard (exactly 50 items per mode). Rule IDs are stable.",
  "sample_count_default": 8,
  "min_pass_items": 50,
  "modes": {
    "render": {
      "description": "Blender 3D character render (1280x720, 12fps typical)",
      "expected_width": 1280,
      "expected_height": 720,
      "item_count": 50,
      "deterministic_checks": [
        { "id": "R01_frames_exist",              "fail_if": "frame_count < 1",                                              "message": "No frame_*.png files in frames directory" },
        { "id": "R02_min_frame_count",           "fail_if": "frame_count < 30",                                             "message": "Too few frames (need >= 30)" },
        { "id": "R03_resolution_uniform",        "fail_if": "unique_dimensions_count > 1",                                  "message": "Inconsistent frame dimensions across samples" },
        { "id": "R04_resolution_expected",       "fail_if": "width != 1280 or height != 720",                               "message": "Frame size must be 1280x720" },
        { "id": "R05_not_all_black",             "fail_if": "dark_ratio_median > 0.90",                                     "message": "Frames mostly black (emission/camera issue)" },
        { "id": "R06_edge_detail",               "fail_if": "edge_mean_median < 3.5",                                       "message": "Edge detail too low (blank/flat field)" },
        { "id": "R07_contrast",                  "fail_if": "stddev_median < 18.0",                                         "message": "Contrast too low (flat image)" },
        { "id": "R08_center_detail",             "fail_if": "center_stddev_median < 12.0",                                  "message": "Center lacks detail (character missing/tiny)" },
        { "id": "R09_not_silhouette",            "fail_if": "center_stddev_median < 15.0 and center_saturation_std < 8.0", "message": "Center is flat grey silhouette" },
        { "id": "R10_motion_ahash",              "fail_if": "max_adjacent_ahash_distance < 3",                              "message": "Adjacent frames nearly identical (no motion)" },
        { "id": "R11_first_last_diff",           "fail_if": "first_last_pixel_diff < 0.5",                                  "message": "First/last frames differ < 0.5 RGB (static)" },
        { "id": "R12_luminance_range",           "fail_if": "mean_luminance_range < 8.0 and max_adjacent_ahash_distance < 5","message": "Luminance + hash both indicate static" },
        { "id": "R13_unique_hashes",             "fail_if": "unique_ahash_count < 3 and frame_count >= 60",                "message": "< 3 unique hashes (looping static image)" },
        { "id": "R14_not_overexposed",           "fail_if": "bright_ratio_median > 0.85",                                  "message": "Frames mostly white/overexposed" },
        { "id": "R15_saturation_present",        "fail_if": "saturation_mean_median < 5.0",                                "message": "Image completely desaturated (greyscale)" },
        { "id": "R16_fps_valid",                 "fail_if": "fps < 10 or fps > 60",                                         "message": "FPS out of range [10, 60]" },
        { "id": "R17_no_corruption",             "fail_if": "corrupt_frame_count > 0",                                     "message": "Corrupted frame(s) detected" },
        { "id": "R18_audio_sync_offset",         "fail_if": "audio_video_offset_ms > 300",                                 "message": "Audio/video offset > 300ms" },
        { "id": "R19_audio_exists",              "fail_if": "has_audio == false",                                           "message": "No audio track in output video" },
        { "id": "R20_filesize_reasonable",       "fail_if": "output_mb < 1 or output_mb > 2000",                           "message": "Output file size out of range (1MB-2GB)" },
        { "id": "R21_aspect_ratio_correct",      "fail_if": "abs(width/height - 16.0/9.0) > 0.02",                         "message": "Aspect ratio is not 16:9" },
        { "id": "R22_video_codec_acceptable",    "fail_if": "video_codec not in ['h264','hevc','vp9','av1']",              "message": "Video codec not in acceptable list" },
        { "id": "R23_audio_codec_acceptable",    "fail_if": "audio_codec not in ['aac','mp3','opus','flac']",              "message": "Audio codec not in acceptable list" },
        { "id": "R24_audio_bitrate_ok",          "fail_if": "audio_bitrate_kbps < 64",                                     "message": "Audio bitrate too low (< 64kbps)" },
        { "id": "R25_no_long_freeze",            "fail_if": "max_identical_frame_streak > 24",                             "message": "Video frozen for > 2s (identical frame streak)" },
        { "id": "R26_subtitle_srt_if_expected",  "fail_if": "subtitle_expected and not srt_exists",                        "message": "Expected subtitle SRT file not found" },
        { "id": "R27_character_region_content",  "fail_if": "center_50pct_mean_brightness < 10",                           "message": "Center 50% region is near-empty (no character)" },
        { "id": "R28_no_flicker",                "fail_if": "inter_frame_brightness_variance_max > 5000",                  "message": "Severe brightness flickering detected" },
        { "id": "R29_color_balance_ok",          "fail_if": "r_channel_mean > b_channel_mean * 2.0 or b_channel_mean > r_channel_mean * 2.0", "message": "Extreme color cast (too red or too blue)" },
        { "id": "R30_total_duration_ok",         "fail_if": "video_duration_s < 5.0 or video_duration_s > 1800",           "message": "Video duration out of expected range (5s-30min)" }
      ],
      "vision_checks": [
        { "id": "V01_character_visible",         "question": "Is a humanoid or mecha character clearly visible (not only props)?",                          "fail_answer": "no_character" },
        { "id": "V02_not_grey_blob",             "question": "Is the character NOT a featureless grey silhouette?",                                         "fail_answer": "grey_silhouette" },
        { "id": "V03_scene_has_depth",           "question": "Is there a recognizable factory/audit scene (floor, backdrop, props)?",                       "fail_answer": "empty_void" },
        { "id": "V04_no_artifacts",              "question": "Are there NO severe glitches: all-black face, T-pose, mesh explosion, z-fighting?",           "fail_answer": "render_artifact" },
        { "id": "V05_motion_visible",            "question": "Is motion OR camera change clearly visible between at least two thumbnails?",                 "fail_answer": "no_motion" },
        { "id": "V06_text_readable",             "question": "If Japanese text is present, is it readable (not tofu/mojibake)?",                            "fail_answer": "garbled_text" },
        { "id": "V07_lighting_natural",          "question": "Is the lighting natural (character not jet-black silhouette, not blown out white)?",          "fail_answer": "bad_lighting" },
        { "id": "V08_character_full_body",       "question": "Is the character mostly visible as full or 3/4 body (not extreme closeup of one part)?",     "fail_answer": "extreme_crop" },
        { "id": "V09_background_appropriate",    "question": "Does the background look like a work/factory environment appropriate for IATF content?",       "fail_answer": "inappropriate_bg" },
        { "id": "V10_no_clipping",               "question": "Is there NO visible mesh clipping (character parts poking through walls/floor)?",             "fail_answer": "mesh_clipping" },
        { "id": "V11_animation_natural",         "question": "Does the character animation look natural (not extreme jitter, snap, or stuck pose)?",        "fail_answer": "unnatural_animation" },
        { "id": "V12_mixamo_rig_used",           "question": "Does the character appear to use standard humanoid proportions (Mixamo-compatible rig)?",     "fail_answer": "non_standard_rig" },
        { "id": "V13_subtitle_visible",          "question": "If subtitles are shown, are they clearly visible and positioned correctly?",                   "fail_answer": "subtitle_missing" },
        { "id": "V14_props_appropriate",         "question": "Are props in the scene appropriate (clipboard, whiteboard, factory equipment)?",               "fail_answer": "inappropriate_props" },
        { "id": "V15_camera_angle_ok",           "question": "Is the camera angle professional (eye-level or slight above, not extreme bottom/top)?",       "fail_answer": "bad_camera_angle" },
        { "id": "V16_character_same_throughout", "question": "Is the same character model used consistently throughout (no unexplained character switch)?",  "fail_answer": "character_inconsistent" },
        { "id": "V17_scene_iatf_relevant",       "question": "Does the scene content visually relate to quality management, auditing, or manufacturing?",   "fail_answer": "scene_irrelevant" },
        { "id": "V18_no_visible_watermark",      "question": "Is there NO visible third-party watermark (Mixamo, stock footage, demo version)?",            "fail_answer": "watermark_visible" },
        { "id": "V19_transitions_smooth",        "question": "Are scene transitions or cuts smooth (no jarring jump-cuts or sudden black frames)?",          "fail_answer": "bad_transition" },
        { "id": "V20_overall_professional",      "question": "Overall, does this video look professional enough for IATF training material?",                "fail_answer": "unprofessional_overall" }
      ]
    },
    "slide": {
      "description": "2D slide video frames (bright background typical)",
      "expected_width": 1280,
      "expected_height": 720,
      "item_count": 50,
      "deterministic_checks": [
        { "id": "S01_frames_exist",              "fail_if": "frame_count < 1",                                             "message": "No slide frames found" },
        { "id": "S02_resolution_uniform",        "fail_if": "unique_dimensions_count > 1",                                 "message": "Inconsistent slide dimensions" },
        { "id": "S03_not_all_black",             "fail_if": "dark_ratio_median > 0.95",                                   "message": "Slides almost entirely black" },
        { "id": "S04_has_content",               "fail_if": "edge_mean_median < 1.5 and stddev_median < 5.0",              "message": "Slide appears blank" },
        { "id": "S05_resolution_expected",       "fail_if": "width != 1280 or height != 720",                             "message": "Slide size must be 1280x720" },
        { "id": "S06_not_all_white",             "fail_if": "bright_ratio_median > 0.98",                                 "message": "Slides almost entirely white (blank)" },
        { "id": "S07_min_slide_count",           "fail_if": "frame_count < 3",                                             "message": "Need at least 3 slide frames" },
        { "id": "S08_audio_exists",              "fail_if": "has_audio == false",                                          "message": "No audio track" },
        { "id": "S09_audio_duration_match",      "fail_if": "abs(audio_duration - video_duration) > 2.0",                 "message": "Audio and video duration mismatch > 2s" },
        { "id": "S10_filesize_reasonable",       "fail_if": "output_mb < 0.5 or output_mb > 500",                         "message": "Output file size out of range" },
        { "id": "S11_no_corruption",             "fail_if": "corrupt_frame_count > 0",                                    "message": "Corrupted slide frame detected" },
        { "id": "S12_fps_valid",                 "fail_if": "fps < 1 or fps > 60",                                         "message": "FPS out of valid range" },
        { "id": "S13_text_density",              "fail_if": "edge_mean_median > 80.0",                                    "message": "Slide overloaded with dense text/noise" },
        { "id": "S14_slide_variance",            "fail_if": "unique_ahash_count < 2 and frame_count >= 3",                "message": "All slides look identical (no content change)" },
        { "id": "S15_no_single_color_fill",      "fail_if": "stddev_median < 3.0",                                        "message": "Slide is single flat color (template not rendered)" },
        { "id": "S16_aspect_ratio_correct",      "fail_if": "abs(width/height - 16.0/9.0) > 0.02",                        "message": "Aspect ratio is not 16:9" },
        { "id": "S17_video_codec_acceptable",    "fail_if": "video_codec not in ['h264','hevc','vp9','av1']",             "message": "Video codec not in acceptable list" },
        { "id": "S18_audio_codec_acceptable",    "fail_if": "audio_codec not in ['aac','mp3','opus','flac']",             "message": "Audio codec not in acceptable list" },
        { "id": "S19_audio_bitrate_ok",          "fail_if": "audio_bitrate_kbps < 64",                                   "message": "Audio bitrate too low (< 64kbps)" },
        { "id": "S20_no_long_freeze",            "fail_if": "max_identical_frame_streak > 120",                           "message": "Slide frozen for > 10s with identical frame" },
        { "id": "S21_audio_no_clipping",         "fail_if": "audio_peak_dbfs > -0.5",                                    "message": "Audio clipping detected (peak near 0 dBFS)" },
        { "id": "S22_first_frame_not_blank",     "fail_if": "first_frame_bright_ratio > 0.98 or first_frame_dark_ratio > 0.98", "message": "First frame is blank (all white or all black)" },
        { "id": "S23_last_frame_not_blank",      "fail_if": "last_frame_bright_ratio > 0.98 or last_frame_dark_ratio > 0.98",  "message": "Last frame is blank (abrupt cutoff)" },
        { "id": "S24_total_duration_ok",         "fail_if": "video_duration_s < 10.0 or video_duration_s > 3600",         "message": "Video duration out of expected range (10s-60min)" },
        { "id": "S25_audio_snr_ok",              "fail_if": "estimated_snr_db < 15.0",                                   "message": "Audio SNR too low (< 15dB, excessive background noise)" }
      ],
      "vision_checks": [
        { "id": "V21_japanese_readable",         "question": "Is all Japanese text readable without tofu/garble?",                                          "fail_answer": "tofu_present" },
        { "id": "V22_layout_ok",                 "question": "Is text within card bounds without severe overlap or cutoff?",                                "fail_answer": "layout_broken" },
        { "id": "V23_no_empty_slides",           "question": "Are all slides non-empty (not blank white/black)?",                                           "fail_answer": "blank_slide" },
        { "id": "V24_title_visible",             "question": "Is a clear title or clause number visible on at least one slide?",                            "fail_answer": "no_title" },
        { "id": "V25_clause_number_correct",     "question": "Does the clause number displayed match the expected IATF section?",                           "fail_answer": "wrong_clause" },
        { "id": "V26_font_consistent",           "question": "Is the font style consistent across slides (not random mix of fonts)?",                       "fail_answer": "font_inconsistent" },
        { "id": "V27_colors_readable",           "question": "Is the text color clearly readable against the background (not same color)?",                 "fail_answer": "low_contrast_text" },
        { "id": "V28_no_overlapping_text",       "question": "Is there NO overlapping or stacked text making content unreadable?",                          "fail_answer": "overlapping_text" },
        { "id": "V29_bullet_points_present",     "question": "Are bullet points or numbered items visible for multi-item content?",                         "fail_answer": "no_structure" },
        { "id": "V30_diagram_if_expected",       "question": "If the IATF clause requires a process diagram, is one visible?",                              "fail_answer": "missing_diagram" },
        { "id": "V31_iatf_branding",             "question": "Is 'IATF 16949' or the clause reference visible on at least one slide?",                      "fail_answer": "no_iatf_reference" },
        { "id": "V32_professional_appearance",   "question": "Does the overall slide look professional (not misaligned, not raw HTML/code visible)?",        "fail_answer": "unprofessional" },
        { "id": "V33_subtitle_sync",             "question": "Is the audio narration topic consistent with the displayed slide content?",                    "fail_answer": "content_mismatch" },
        { "id": "V34_no_system_ui_visible",      "question": "Is there NO system UI, browser chrome, or desktop visible in the frame?",                     "fail_answer": "system_ui_visible" },
        { "id": "V35_content_completeness",      "question": "Does the last slide indicate a conclusion or summary (not mid-sentence cutoff)?",              "fail_answer": "content_incomplete" },
        { "id": "V36_slide_style_consistent",    "question": "Is the slide design style (colors, background, header) consistent across all slides?",         "fail_answer": "style_inconsistent" },
        { "id": "V37_key_terms_highlighted",     "question": "Are important IATF terms or clause keywords visually highlighted (bold/color/underline)?",    "fail_answer": "no_highlights" },
        { "id": "V38_no_placeholder_text",       "question": "Are there NO placeholder texts like '(ここに入力)' or 'TODO' visible in the slide?",           "fail_answer": "placeholder_visible" },
        { "id": "V39_layout_margins_ok",         "question": "Is there adequate margin around text (not touching slide edges)?",                             "fail_answer": "no_margins" },
        { "id": "V40_heading_hierarchy_visible", "question": "Is a clear heading hierarchy visible (main title larger than body text)?",                     "fail_answer": "no_hierarchy" },
        { "id": "V41_color_scheme_professional", "question": "Is the color scheme professional (not garish/neon, appropriate for business training)?",      "fail_answer": "bad_colors" },
        { "id": "V42_content_not_truncated",     "question": "Is text fully visible without being cut off at slide edges or by other elements?",             "fail_answer": "text_truncated" },
        { "id": "V43_no_animation_glitch",       "question": "Are slide transitions free of visible glitches (no half-rendered frames, tearing)?",          "fail_answer": "transition_glitch" },
        { "id": "V44_slide_sequence_logical",    "question": "Do slides appear in logical order (intro → content → summary, not random)?",                  "fail_answer": "illogical_sequence" },
        { "id": "V45_narration_quality",         "question": "Does the audio narration sound clear and professional (not robotic/distorted/muffled)?",       "fail_answer": "bad_narration" }
      ]
    }
  },
  "ai_output_schema": {
    "approved": "boolean",
    "mode": "render|slide",
    "checks": "array of {id, pass, evidence}",
    "total_checked": "integer",
    "total_pass": "integer",
    "reason": "string summary if fail"
  },
  "enforcement": {
    "min_pass_ratio": 0.90,
    "hard_fail_ids": [
      "R05_not_all_black",
      "R19_audio_exists",
      "S03_not_all_black",
      "S08_audio_exists",
      "V01_character_visible",
      "V06_text_readable",
      "V21_japanese_readable",
      "V23_no_empty_slides"
    ],
    "note": "hard_fail_ids must ALL pass regardless of min_pass_ratio. render=50 items (R01-R30 + V01-V20). slide=50 items (S01-S25 + V21-V45)."
  }
}
