#RADIOSS STARTER
/BEGIN
press_blanking_stripper_v001
      2024       0
$---+----1----+----2----+----3----+----4----+----5----+----6----+----7----+----8
$  PRESS BLANKING WITH REAL STRIPPER & CONTACT OPTIMIZATION
$  Resolves initial penetration and dynamic shock collapse (INC-092)
$
$  Material: SPCC cold-rolled steel t=1.2mm
$  Stripper: Rigid clamp with smooth force ramp control (/CLOAD)
$  Contact card: Type 7 with Istf=4 (auto-stiffness) and Igap=2 (thickness gap)
$---+----1----+----2----+----3----+----4----+----5----+----6----+----7----+----8
/UNIT
kg                    mm                    ms
/MAT/PLAS_JOHNS/2
Cold_Steel_SPCC_1t2
#        Init. dens.
          7.85E-6
#                  E                  nu
              210000                 0.3
#   Johnson-Cook flow stress: A + B*eps^n * (1 + C*ln(epdot/ep0)) * (1 - Theta^m)
#                  a                   b                   n                   c                   m
               300.0               500.0               0.25               0.014               1.03
#               eps0              ref_temp             melt_temp
               0.001               293.15              1750.0
/FAIL/JOHNSON/2
$ BLANKING FAILURE: Fracture strain at high triaxiality (shear dominant)
#               d1                  d2                  d3                  d4                  d5
              -0.09                0.25               -0.5               0.014                3.87
$  Lode angle correction (shear-dominant blanking, eta_min=-1/3)
              -0.33
/PROP/SHELL/2
Blank_Sheet_12mm
#   Ishell               Ismstr
         24                    0
#                  h
               1.2
#        N           Istrain
         5                 1
/PART/2
Blank_Sheet_Part
         2         2
/NODE
$  Pre-gap optimized nodal positions (Z-offset for safety thickness gap)
$  Nodal strip representation: t=1.2mm, neutral axis Y=0
       1        0.00       0.00       0.00
       2        2.00       0.00       0.00
       3        4.00       0.00       0.00
       4        6.00       0.00       0.00
       5        8.00       0.00       0.00
       6       10.00       0.00       0.00
       7       12.00       0.00       0.00
       8       14.00       0.00       0.00
       9       16.00       0.00       0.00
      10       18.00       0.00       0.00
      11       20.00       0.00       0.00
/SHELL
         1         2         1         2         3         4
         2         2         3         4         5         6
         3         2         5         6         7         8
         4         2         7         8         9        10
         5         2         9        10        11         1
/BCS
$  Flexible clamp: ends clamped in rotational DOFs, dynamic stripper holds Y displacement
         1         1         1         1         0         0         0
        11         1         1         1         0         0         0
/IMPDISP/2
punch_blanking
$                   Tstart              Tstop                 dir   grnd_id
                     0.001              0.003                  2         2
         2
/GRNOD/NODE/2
punch_contact_nodes
       5       6       7
/FUNCT/2
#     Time      Displacement_mm  (punch travel = 1.5 * t = 1.8mm for full blanking)
       0.0              0.0
       0.003             1.8
/INTER/TYPE7/2
Contact_PunchSheet
$--- Friction: mu=0.08, contact stiffness flags: Istf=4, Igap=2, Idel=2
               0.08
#   Istf    Igap    Idel    Iako    Gapsmult
       4       2       2       1        1.0
/END
