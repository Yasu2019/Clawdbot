#RADIOSS STARTER
/BEGIN
press_blanking_v001
      2024       0
$---+----1----+----2----+----3----+----4----+----5----+----6----+----7----+----8
$  PRESS BLANKING / PUNCHING ANALYSIS
$  Target: Burr height, Shear zone / Fracture zone ratio, Die clearance effect
$
$  KEY DEFECT ANALYSIS:
$    - Shear zone %  (clean cut face) vs Fracture zone % (rough face)
$    - Burr formation at clearance > 10%
$    - Roll-over at punch entry side
$
$  Material: SPCC cold-rolled steel t=1.2mm
$  Die clearance: 0.06mm = 5% (baseline - will be swept 2%~15%)
$  Punch speed: 5000 mm/s
$---+----1----+----2----+----3----+----4----+----5----+----6----+----7----+----8
/UNIT
kg                    mm                    ms
/MAT/PLAS_JOHNS/2
Cold_Steel_SPCC_1t2
#        Init. dens.
          7.85E-6
#                  E                  nu
              210000                 0.3
#   Johnson-Cook flow stress: A + B*eps^n * (1 + C*ln(epdot/ep0)) * (1 - Theta^m)
#                  a                   b                   n                   c                   m
               300.0               500.0               0.25               0.014               1.03
#               eps0              ref_temp             melt_temp
               0.001               293.15              1750.0
/FAIL/JOHNSON/2
$ BLANKING FAILURE: Fracture strain at high triaxiality (shear dominant)
$ d3 negative = compressive triaxiality accelerates fracture (shear zone)
#               d1                  d2                  d3                  d4                  d5
              -0.09                0.25               -0.5               0.014                3.87
$  Lode angle correction (shear-dominant blanking, eta_min=-1/3)
              -0.33
/FAIL/TSTRN/2
$ Alternative: total strain failure for shear band detection
$  eps_f = 1.5 (ductile fracture at high shear)
               1.5
/PROP/SHELL/2
Blank_Sheet_12mm
#   Ishell               Ismstr
         24                    0
#                  h
               1.2
#        N           Istrain
         5                 1
/PART/2
Blank_Sheet_Part
         2         2
/NODE
$  Minimal V-punch mesh for blanking clearance study
$  Punch moves DOWN in -Y, sheet clamped at ends
       1        0.00       0.00       0.00
       2        2.00       0.00       0.00
       3        4.00       0.00       0.00
       4        6.00       0.00       0.00
       5        8.00       0.00       0.00
       6       10.00       0.00       0.00
       7       12.00       0.00       0.00
       8       14.00       0.00       0.00
       9       16.00       0.00       0.00
      10       18.00       0.00       0.00
      11       20.00       0.00       0.00
/SHELL
         1         2         1         2         3         4
         2         2         3         4         5         6
         3         2         5         6         7         8
         4         2         7         8         9        10
         5         2         9        10        11         1
/BCS
$  Clamp sheet ends (blankholder simulation)
         1         1         1         1         0         0         0
        11         1         1         1         0         0         0
/IMPDISP/2
punch_blanking
$                   Tstart              Tstop                 dir   grnd_id
                     0.001              0.003                  2         2
         2
/GRNOD/NODE/2
punch_contact_nodes
       5       6       7
/FUNCT/2
#     Time      Displacement_mm  (punch travel = 1.5 * t = 1.8mm for full blanking)
       0.0              0.0
       0.003             1.8
/INTER/TYPE7/2
Contact_PunchSheet
               0.08
/END
