/*--------------------------------*- C++ -*----------------------------------*\
| Moldflow Phase 3: polymer (const mu; WLF applied at injection when 3b)    |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       const;
    thermo          hConst;
    equationOfState rhoConst;
    specie          specie;
    energy          sensibleEnthalpy;
}

mixture
{
    specie
    {
        molWeight   42;
    }
    thermodynamics
    {
        Cp          1500;
        Hf          0;
    }
    equationOfState
    {
        rho         1200;
    }
    transport
    {
        mu          MU_CONST_PLACEHOLDER;
        Pr          0.7;
    }
}

// ************************************************************************* //
