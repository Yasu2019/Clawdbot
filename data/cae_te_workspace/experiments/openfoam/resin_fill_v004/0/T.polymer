FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0";
    object      T.polymer;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 323;

boundaryField
{
    inlet1
    {
        type            fixedValue;
        value           uniform 323;
    }
    inlet2
    {
        type            fixedValue;
        value           uniform 513;
    }
    inlet3
    {
        type            fixedValue;
        value           uniform 323;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform 323;
        value           uniform 323;
    }
    walls
    {
        type            fixedValue;
        value           uniform 323;
    }
    columnFvMeshInfo:default
    {
        type            empty;
    }
}


// ************************************************************************* //
