FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform T_MOLD_PLACEHOLDER;

boundaryField
{
    inlet1
    {
        type            fixedValue;
        value           uniform T_MOLD_PLACEHOLDER;
    }

    inlet2
    {
        type            fixedValue;
        value           uniform T_MELT_PLACEHOLDER;
    }

    inlet3
    {
        type            fixedValue;
        value           uniform T_MOLD_PLACEHOLDER;
    }

    outlet
    {
        type            inletOutlet;
        inletValue      uniform T_MOLD_PLACEHOLDER;
        value           uniform T_MOLD_PLACEHOLDER;
    }

    walls
    {
        type            fixedValue;
        value           uniform T_MOLD_PLACEHOLDER;
    }

    frontAndBack
    {
        type            empty;
    }
}

