{
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "{{DIFFUSION_MODEL}}",
      "weight_dtype": "{{WEIGHT_DTYPE}}"
    }
  },
  "2": {
    "class_type": "ModelSamplingSD3",
    "inputs": {
      "model": ["1", 0],
      "shift": "{{SHIFT}}"
    }
  },
  "3": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "{{TEXT_ENCODER}}",
      "type": "wan"
    }
  },
  "4": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "{{VAE_MODEL}}"
    }
  },
  "5": {
    "class_type": "CLIPVisionLoader",
    "inputs": {
      "clip_name": "{{CLIP_VISION_MODEL}}"
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{POSITIVE_PROMPT}}",
      "clip": ["3", 0]
    }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{NEGATIVE_PROMPT}}",
      "clip": ["3", 0]
    }
  },
  "8": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{REFERENCE_IMAGE}}"
    }
  },
  "9": {
    "class_type": "CLIPVisionEncode",
    "inputs": {
      "clip_vision": ["5", 0],
      "image": ["8", 0],
      "crop": "center"
    }
  },
  "10": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "{{POSE_VIDEO}}"
    }
  },
  "11": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": ["10", 0]
    }
  },
  "12": {
    "class_type": "WanSCAILToVideo",
    "inputs": {
      "positive": ["6", 0],
      "negative": ["7", 0],
      "vae": ["4", 0],
      "width": "{{WIDTH}}",
      "height": "{{HEIGHT}}",
      "length": "{{LENGTH}}",
      "batch_size": 1,
      "pose_video": ["11", 0],
      "pose_strength": "{{POSE_STRENGTH}}",
      "pose_start": 0.0,
      "pose_end": 1.0,
      "reference_image": ["8", 0],
      "clip_vision_output": ["9", 0],
      "video_frame_offset": 0,
      "previous_frame_count": 5
    }
  },
  "13": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["2", 0],
      "seed": "{{SEED}}",
      "steps": "{{STEPS}}",
      "cfg": "{{CFG}}",
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": ["12", 0],
      "negative": ["12", 1],
      "latent_image": ["12", 2],
      "denoise": 1.0
    }
  },
  "14": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["13", 0],
      "vae": ["4", 0]
    }
  },
  "15": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["14", 0],
      "fps": "{{FPS}}"
    }
  },
  "16": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["15", 0],
      "filename_prefix": "{{FILENAME_PREFIX}}",
      "format": "mp4",
      "codec": "h264"
    }
  }
}
