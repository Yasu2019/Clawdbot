ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('AP242 PMI test fixture for CETOL L4 (T-iy63)'),'2;1');
FILE_NAME('ap242_pmi_sample.step','2026-07-07T06:30:00',('clawstack'),(''),'','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('managed model based 3d engineering');
#2=PRODUCT('S1_PLATE','test plate','',(#3));
#3=PRODUCT_CONTEXT('',#1,'mechanical');
#90=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
/* --- geometry stub: two holes as cylinders --- */
#100=CYLINDRICAL_SURFACE('hole_a',#101,5.0);
#102=CYLINDRICAL_SURFACE('hole_b',#103,3.1);
/* --- dimensional characteristic 1: hole pitch 45 +0.10/-0.05 --- */
#10=DIMENSIONAL_LOCATION('hole_pitch','distance between hole_a and hole_b',#100,#102);
#12=SHAPE_DIMENSION_REPRESENTATION('',(#13),#91);
#13=(LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(45.0),#90)MEASURE_REPRESENTATION_ITEM()REPRESENTATION_ITEM('nominal value'));
#11=DIMENSIONAL_CHARACTERISTIC_REPRESENTATION(#10,#12);
#16=MEASURE_WITH_UNIT(LENGTH_MEASURE(-0.05),#90);
#17=MEASURE_WITH_UNIT(LENGTH_MEASURE(0.10),#90);
#15=TOLERANCE_VALUE(#16,#17);
#14=PLUS_MINUS_TOLERANCE(#15,#10);
/* --- dimensional characteristic 2: hole_a diameter 10 +/-0.02 --- */
#20=DIMENSIONAL_SIZE(#100,'diameter');
#22=SHAPE_DIMENSION_REPRESENTATION('',(#23),#91);
#23=(LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(10.0),#90)MEASURE_REPRESENTATION_ITEM()REPRESENTATION_ITEM('nominal value'));
#21=DIMENSIONAL_CHARACTERISTIC_REPRESENTATION(#20,#22);
#26=MEASURE_WITH_UNIT(LENGTH_MEASURE(-0.02),#90);
#27=MEASURE_WITH_UNIT(LENGTH_MEASURE(0.02),#90);
#25=TOLERANCE_VALUE(#26,#27);
#24=PLUS_MINUS_TOLERANCE(#25,#20);
/* --- geometric tolerance: position dia 0.1 to datums A|B --- */
#31=LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.1),#90);
#30=POSITION_TOLERANCE('hole_a_position','position of hole_a',#31,#100);
#35=LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.05),#90);
#34=FLATNESS_TOLERANCE('base_flatness','flatness of base face',#35,#104);
/* --- datums --- */
#40=DATUM('','',#104,.F.,'A');
#41=DATUM('','',#105,.F.,'B');
#91=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNIT_ASSIGNED_CONTEXT((#90))REPRESENTATION_CONTEXT('',''));
#101=AXIS2_PLACEMENT_3D('',#110,$,$);
#103=AXIS2_PLACEMENT_3D('',#111,$,$);
#104=ADVANCED_FACE('base_face',(),#112,.T.);
#105=ADVANCED_FACE('side_face',(),#113,.T.);
#110=CARTESIAN_POINT('',(0.,0.,0.));
#111=CARTESIAN_POINT('',(45.,0.,0.));
#112=PLANE('',#101);
#113=PLANE('',#103);
ENDSEC;
END-ISO-10303-21;
