# OpenClaw TTS Router env
TTS_DEFAULT_ENGINE=voicevox
TTS_OUTPUT_DIR=/app/outputs
VOICEVOX_BASE_URL=http://host.docker.internal:50021
STYLEBERT_BASE_URL=http://host.docker.internal:50000
GPT_SOVITS_BASE_URL=http://host.docker.internal:9880
FISH_AUDIO_API_KEY=
FISH_AUDIO_BASE_URL=https://api.fish.audio
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-tts
ALLOW_CLOUD_TTS=false
REQUIRE_REVIEW_FOR_EXTERNAL=true
